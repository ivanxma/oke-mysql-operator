# Copy to internal_doc/openshift/mysql-operator/config.env (Git ignored).
# Run on the admin host after sourcing its shared OKD env.sh.
# Empty derives the intended API from ADMIN_WORKDIR/cluster-domain.
MYSQL_EXPECTED_API_SERVER=
KUBE_CONTEXT=
MYSQL_WORKER_NAMES='worker01 worker02 worker03'
OPERATOR_NAMESPACE=mysql-operator
MYSQL_NAMESPACE=mysql
MYSQL_CLUSTER_NAME=mycluster
MYSQL_SECRET_NAME=mycluster-root
MYSQL_INSTANCES=3
MYSQL_ROUTER_INSTANCES=2
MYSQL_ANTI_AFFINITY=required
# Optional lab tuning; keep requests appropriate to workload/worker capacity.
MYSQL_SERVER_CPU_REQUEST=500m
MYSQL_SIDECAR_CPU_REQUEST=100m
PRIMARY_MYSQL_NAMESPACE=mysql
PRIMARY_MYSQL_CLUSTER_NAME=mycluster
REPLICA_MYSQL_NAMESPACE=mysql-secondary
REPLICA_MYSQL_CLUSTER_NAME=mycluster2
REPLICA_MYSQL_SECRET_NAME=mycluster2-root
REPLICA_MYSQL_INSTANCES=3
REPLICA_MYSQL_ROUTER_INSTANCES=2
REPLICA_BASE_SERVER_ID=2000
HELM_VERSION=v4.3.1
OPERATOR_CHART_VERSION=2.3.0
MYSQL_VERSION=26.7.0
# Step 03: instance-principal-only OCI Block CSI preparation.
# Required only when running step 03; set identifiers privately.
MYSQL_OCI_COMPARTMENT_ID=
MYSQL_OCI_COMPARTMENT_NAME=
MYSQL_OCI_REGION=
# Optional existing Python interpreter containing OCI SDK and PyYAML.
MYSQL_OCI_PYTHON=
# Step 03 creates mysql-oci-bv. Or select an existing working StorageClass.
# Empty resolves one default class.
# Storage must support UID/GID 27, fsGroup and SELinux on OKD.
STORAGE_CLASS=mysql-oci-bv
REPLICA_STORAGE_CLASS=mysql-oci-bv
MYSQL_STORAGE_SIZE=50Gi
REPLICA_STORAGE_SIZE=50Gi
MYSQL_ROOT_PASSWORD_FILE=
K8S_CLUSTER_DOMAIN=cluster.local
WAIT_TIMEOUT_SECONDS=1800
LOCAL_MYSQL_PORT=3306
