# Generated by step 00 beside each regional OKD profile; never store credentials here.
MYSQL_SITE_ROLE=PRIMARY
MYSQL_OKD_UID=
MYSQL_SUBMARINER_ID=
MYSQL_PEER_REGION=eu-frankfurt-1
MYSQL_WORKER_NAMES=
MYSQL_NAMESPACE=mysql-cluster1
MYSQL_CLUSTER_NAME=cluster1
MYSQL_SECRET_NAME=cluster1-root
MYSQL_INSTANCES=1
MYSQL_ROUTER_INSTANCES=1
MYSQL_BASE_SERVER_ID=1000
MYSQL_LAB_MODE=true
OPERATOR_NAMESPACE=mysql-operator
MYSQL_VERSION=26.10.0
OPERATOR_CHART_VERSION=2.3.1
HELM_VERSION=v4.3.1
STORAGE_CLASS=mysql-oci-bv
MYSQL_STORAGE_SIZE=50Gi
MYSQL_ANTI_AFFINITY=required
MYSQL_SERVER_CPU_REQUEST=500m
MYSQL_SIDECAR_CPU_REQUEST=100m
WAIT_TIMEOUT_SECONDS=1800
LOCAL_MYSQL_PORT=3306
K8S_CLUSTER_DOMAIN=cluster.local
# Compatibility settings used only by shared worker/storage helpers.
PRIMARY_MYSQL_NAMESPACE=mysql-cluster1
PRIMARY_MYSQL_CLUSTER_NAME=cluster1
REPLICA_MYSQL_NAMESPACE=mysql-cluster2
REPLICA_MYSQL_CLUSTER_NAME=cluster2
REPLICA_MYSQL_SECRET_NAME=cluster2-root
REPLICA_MYSQL_INSTANCES=1
REPLICA_MYSQL_ROUTER_INSTANCES=1
REPLICA_BASE_SERVER_ID=2000
REPLICA_STORAGE_CLASS=mysql-oci-bv
REPLICA_STORAGE_SIZE=50Gi
