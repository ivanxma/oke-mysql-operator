# Sample mandatory settings: blank values must be supplied privately.
# Run 00-create-workspace.sh to generate protected profiles under generated/openshift/.
# See docs/configuration.md. Never put actual deployment values in this file.
# Register the control-plane IP later with 05-register-node-ip.sh; do not guess it.
# Optional settings belong in the sibling community.optional.env file.
ADMIN_HOST=                       # Host running preparation; loopback if run there
ADMIN_USER=opc
ADMIN_WORKDIR=                    # Dedicated absolute workspace under /home/
TARGET_USER=core                  # Installed SCOS node SSH account
SSH_IDENTITY=                     # Private key path on the invoking host
CLUSTER_NAME=okd-sno
BASE_DOMAIN=                      # Controlled private DNS base domain
MACHINE_CIDR=                     # Actual private node subnet CIDR
POD_CIDR=10.128.0.0/14
SERVICE_CIDR=172.30.0.0/16
INSTALL_DISK=/dev/sda             # New control-plane VM installation disk
OCI_REGION=
OCI_AUTH=instance_principal
OCI_COMPARTMENT_ID=
OCI_COMPARTMENT_NAME=
