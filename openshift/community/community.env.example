# Copy this template to internal_doc/openshift/community.env (ignored by Git).
# Or set OKD_CONFIG_FILE to another private configuration file.
ADMIN_HOST=                       # Required: admin/jump-host address
ADMIN_USER=opc
ADMIN_WORKDIR=                    # Required: absolute remote workspace under /home/
TARGET_USER=opc
NODE_IP=                          # Required: private target IPv4 address
SSH_IDENTITY=                     # Required for zero-argument step 01: local private key path
OKD_VERSION=5.0.0-okd-scos.3
CLUSTER_NAME=okd-sno
BASE_DOMAIN=                      # Required: controlled private DNS base domain
MACHINE_CIDR=                     # Required: target subnet CIDR
POD_CIDR=10.128.0.0/14
SERVICE_CIDR=172.30.0.0/16
INSTALL_DISK=/dev/sda
# Worker media auto-installs to this boot disk on a NEW VM only.
WORKER_INSTALL_DISK=/dev/sda
# Initial SNO=1; set explicitly to total node count after adding workers.
EXPECTED_NODE_COUNT=1
# Optional absolute CA file on admin host when using custom ingress certificates.
INGRESS_CA_FILE=
# Optional explicit override. KUBECONFIG must be an absolute file on the admin host.
# Otherwise env.sh preserves exported KUBECONFIG or derives it from ADMIN_WORKDIR.
# KUBECONFIG=/absolute/path/to/cluster-kubeconfig
OCI_BUCKET=
OCI_NAMESPACE=
OCI_REGION=
OCI_AUTH=instance_principal
OCI_COMPARTMENT_ID=
OCI_COMPARTMENT_NAME=
# Optional but needed for full browser/API security-rule validation.
CLIENT_CIDR=                      # Actual corporate client source network; keep private
