# Optional overrides only. Copy beside community.env as community.optional.env.
# The scripts work without this file. Uncomment only values you need to change.
# OKD_VERSION=5.0.0-okd-scos.3
# OCI_BUCKET=                     # Empty/unset: create and register a generated name
# OCI_NAMESPACE=                  # Empty/unset: discover instance-principal tenancy
# CLIENT_CIDR=                    # Optional client-rule evidence; blank gives WARN
# EXPECTED_NODE_COUNT=1           # Update after adding workers for strict node checks
# WORKER_INSTALL_DISK=/dev/sda
# INGRESS_CA_FILE=                # Optional custom ingress CA file on admin host
# KUBECONFIG=                     # Absolute selected auth file; no implicit default
# OKD_STATE_DIR=                  # Private local state; derived per region by default
# SOCKS_PORT=1080
# MYSQL_OPENSHIFT_CONFIG=
# MYSQL_STATE_DIR=
# MYSQL_OCI_PYTHON=
