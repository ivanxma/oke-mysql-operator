# Copy beside the selected generated OKD community.env as submariner.env on the admin host.
# London KUBECONFIG and expected API come from the London regional env.sh.
SUBMARINER_VERSION=0.24.2
SUBMARINER_TARGET_ID=okd-london
SUBMARINER_TARGET_GATEWAY=               # Exact Ready worker node name, never control plane
# Set these only after the corresponding acceptance/review is complete.
SUBMARINER_LONDON_INSTALLATION_VERIFIED=false
SUBMARINER_COMPATIBILITY_REVIEWED=false  # Exact OKD/Kubernetes + OVN NB DB >=6.1 compatibility
SUBMARINER_NETWORK_REVIEWED=false        # DRG/routes, NSGs, ports, DNS, MTU, egress
# Peer enrollment is optional; configure config.optional.env.example separately.
SUBMARINER_ENABLE_PEER=false
