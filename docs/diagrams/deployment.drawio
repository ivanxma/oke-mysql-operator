        <mxCell id="dns-forwarding-details" parent="v42" vertex="1" value="&lt;b&gt;Cross-OKE DNS forwarding&lt;/b&gt;&lt;br/&gt;c2 → c1: mysql.svc.cluster.local&lt;br/&gt;and mysql-secondary.svc.cluster.local&lt;br/&gt;c1 → c2: mysql-tertiary.svc.cluster.local&lt;br/&gt;&lt;br/&gt;Both retain cluster.local.&lt;br/&gt;Forward only remote namespaces.&lt;br/&gt;UDP/TCP 53 between CoreDNS pods.&lt;br/&gt;Refresh step 05 if DNS pod IPs change." style="fontFamily=Oracle Sans,Arial;fontColor=#312D2A;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;fontSize=14;fontStyle=0;">
