# Copy to config.env and edit before running the scripts. This is a Bash file.
# Run every step as your normal kubectl user, not with sudo.
# Empty KUBE_CONTEXT uses the current kubectl context at the start of each step.
KUBE_CONTEXT=""
OPERATOR_NAMESPACE="mysql-operator"
MYSQL_NAMESPACE="mysql"
MYSQL_CLUSTER_NAME="mycluster"
MYSQL_SECRET_NAME="mycluster-root"

HELM_VERSION="v4.3.1"
OPERATOR_CHART_VERSION="2.3.0"
MYSQL_VERSION="26.7.0"
MYSQL_INSTANCES=3
MYSQL_ROUTER_INSTANCES=2
# Empty selects the single default StorageClass. The CSI driver must work.
STORAGE_CLASS=""
MYSQL_STORAGE_SIZE="10Gi"
# required: separate worker per MySQL instance; preferred: allow co-location.
MYSQL_ANTI_AFFINITY="required"
WAIT_TIMEOUT_SECONDS=1800
LOCAL_MYSQL_PORT=3306

# Optional existing password file for unattended first-time Secret creation.
# File contents are the password; a final newline is removed. Keep mode 600.
# If empty, step 05 prompts twice without echo. Existing Secrets are reused.
MYSQL_ROOT_PASSWORD_FILE=""
