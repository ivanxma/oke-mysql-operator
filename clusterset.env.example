# Steps 11-13 read config.env first, then this file copied to clusterset.env.
# These scripts use the existing global operator in the same Kubernetes cluster.
PRIMARY_MYSQL_NAMESPACE="mysql"
PRIMARY_MYSQL_CLUSTER_NAME="mycluster"
REPLICA_MYSQL_NAMESPACE="mysql-secondary"
REPLICA_MYSQL_CLUSTER_NAME="mycluster2"
REPLICA_MYSQL_SECRET_NAME="mycluster2-root"
REPLICA_BASE_SERVER_ID=2000
REPLICA_MYSQL_INSTANCES=3
REPLICA_MYSQL_ROUTER_INSTANCES=2
# Empty uses the primary cluster's StorageClass. Size must accommodate its data.
REPLICA_STORAGE_CLASS=""
REPLICA_STORAGE_SIZE="10Gi"
K8S_CLUSTER_DOMAIN="cluster.local"
# The replica uses the primary's exact MySQL version, edition, root credentials,
# and self-signed TLS setting. Managed TLS requires a separately designed setup.
