# Copy to cluster3.env; read after root config.env/clusterset.env and oke2/config.env.
C1_KUBECONFIG="$HOME/.kube/config"
# Empty discovers the context from C1_KUBECONFIG, never from config2.
# C1_CONTEXT="context-c1-cum6zxntj4q"
C1_SOURCE_NAMESPACE="mysql"
C1_SOURCE_CLUSTER="mycluster"
CLUSTER3_NAMESPACE="mysql-tertiary"
CLUSTER3_NAME="mycluster3"
CLUSTER3_SECRET="mycluster3-root"
CLUSTER3_BASE_SERVER_ID=3000
CLUSTER3_INSTANCES=3
CLUSTER3_ROUTERS=2
CLUSTER3_STORAGE_CLASS="oci-bv"
CLUSTER3_STORAGE_SIZE="10Gi"
# Both clusters currently use cluster.local. Namespace-specific forwarding
# avoids forwarding the whole overlapping DNS zone.
K8S_CLUSTER_DOMAIN="cluster.local"
# Optional stable, reachable DNS resolver IPs (space separated).
# Empty discovers current Ready CoreDNS pod IPs: rerun step 05 if those change.
C1_DNS_SERVERS=""
C2_DNS_SERVERS=""
