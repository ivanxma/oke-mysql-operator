# Copy to config.env. These settings are only for the second OKE cluster.
OCI_REGION="eu-frankfurt-1"
OCI_COMPARTMENT_ID="ocid1.compartment.REPLACE_ME"
C2_CLUSTER_ID="ocid1.cluster.REPLACE_ME"
C2_KUBECONFIG="$HOME/.kube/config2"
C2_KUBE_ENDPOINT="PRIVATE_ENDPOINT"
# Leave empty to use the OCI CLI's configured profile/authentication defaults.
OCI_PROFILE=""
OCI_AUTH=""
